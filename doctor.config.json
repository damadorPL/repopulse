{
  "$schema": "https://react.doctor/schema/config.json",
  "rootDir": "apps/web",
  "blocking": "warning",
  "adoptExistingLintConfig": false,
  "customRulesOnly": true,
  "supplyChain": {
    "enabled": false
  },
  "serverAuthFunctionNames": ["getCurrentUserOrThrow", "requireUser", "getSuperAdminOrThrow", "requireSuperAdmin"],
  "categories": {
    "Security": "error"
  },
  "ignore": {
    "files": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/.turbo/**", "**/coverage/**", "next-env.d.ts"],
    "overrides": [
      {
        "files": ["src/app/api/github-app/webhook/route.ts"],
        "rules": ["react-doctor/webhook-signature-risk"]
      },
      {
        "files": ["src/server/actions/email-settings.ts", "src/server/actions/notifications.ts"],
        "rules": ["react-doctor/server-no-mutable-module-state"]
      },
      {
        "files": ["src/server/commit-states.ts"],
        "rules": ["react-doctor/server-sequential-independent-await"]
      },
      {
        "files": ["**/*.test.ts", "**/*.test.tsx"],
        "rules": ["react-doctor/no-high-complexity-react-function", "react-doctor/no-giant-component"]
      }
    ]
  },
  "rules": {
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/rerender-memo-with-default-value": "off",
    "react-doctor/no-ref-current-in-render": "off",
    "react-doctor/nextjs-async-client-component": "off",
    "react-doctor/nextjs-inline-script-missing-id": "off",
    "react-doctor/nextjs-no-google-analytics-script": "off",
    "react-doctor/nextjs-no-css-link": "off",
    "react-doctor/nextjs-no-font-link": "off",
    "react-doctor/nextjs-no-head-import": "off",
    "react-doctor/nextjs-no-a-element": "off",
    "react-doctor/nextjs-no-script-in-head": "off",
    "react-doctor/nextjs-no-native-script": "off",
    "react-doctor/nextjs-no-polyfill-script": "off",

    "react-doctor/fieldset-requires-legend": "error",
    "react-doctor/details-requires-summary": "error",
    "react-doctor/empty-table-header": "error",
    "react-doctor/no-aria-hidden-on-body": "error",
    "react-doctor/no-duplicate-static-id-reference": "error",
    "react-doctor/no-presentation-role-conflict": "error",
    "react-doctor/no-ungated-tailwind-animation": "error",

    "react-doctor/activity-wraps-effect-heavy-subtree": "error",
    "react-doctor/nextjs-no-client-fetch-for-server-data": "error",
    "react-doctor/no-cascading-set-state": "error",
    "react-doctor/no-collapse-request-error-to-empty-state": "error",
    "react-doctor/no-impure-call-at-module-scope": "error",
    "react-doctor/hooks-no-nan-in-deps": "error",
    "react-doctor/server-dedup-props": "error",
    "react-doctor/data-table-requires-accessible-name": "error",
    "react-doctor/loading-action-preserves-trigger": "error",
    "react-doctor/no-aria-invalid-without-description": "error",
    "react-doctor/no-skipped-heading-level": "error",
    "react-doctor/no-unbounded-animation-frame-loop": "error",

    "react-doctor/no-hover-only-reveal": "error",
    "react-doctor/no-invisible-focus-control": "error",
    "react-doctor/no-redundant-title-tooltip": "error"
  }
}
