{
  "name": "@repopulse/queue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./src/events.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
