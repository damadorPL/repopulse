{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "RepoPulse Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024", "ES2025.Collection"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "sourceMap": false,
    "plugins": [{ "name": "next" }]
  }
}
