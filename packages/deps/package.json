{
  "name": "@repopulse/deps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./limits": {
      "types": "./src/limits.ts",
      "default": "./dist/limits.js"
    },
    "./sandbox-contract": {
      "types": "./src/sandbox-contract.ts",
      "default": "./dist/sandbox-contract.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "semver": "7.8.6",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
