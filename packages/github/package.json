{
  "name": "@repopulse/github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./watched-paths": {
      "types": "./src/watched-paths.ts",
      "default": "./dist/watched-paths.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
