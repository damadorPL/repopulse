{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "promise", "oxc", "unicorn", "node"],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "es2026": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "packages/db/src/generated/**",
    "**/next-env.d.ts",
    "PRD/**"
  ],
  "settings": {
    "next": {
      "rootDir": ["apps/web/"]
    },
    "react": {
      "version": "19.3"
    },
    "better-tailwindcss": {
      "cwd": "apps/web",
      "entryPoint": "src/app/globals.css"
    }
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "oxc/no-map-spread": "error",
    "oxc/approx-constant": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-this-in-exported-function": "error",
    "oxc/branches-sharing-code": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/consistent-function-scoping": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-deprecated": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/only-throw-error": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-as-default-member": "error",
    "import/no-mutable-exports": "error",
    "import/no-commonjs": "error",
    "import/first": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-nesting": "error",
    "node/no-path-concat": "error",
    "node/no-new-require": "error",
    "node/no-exports-assign": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/no-shadow": "error",
    "eslint/default-case-last": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-concat": "error",
    "eslint/no-object-constructor": "error",
    "eslint/radix": "error",
    "no-control-regex": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }]
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "plugins": ["eslint", "typescript", "import", "promise", "oxc", "unicorn", "node", "react", "jsx-a11y", "nextjs"],
      "jsPlugins": ["eslint-plugin-better-tailwindcss"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/hooks": "error",
        "react/rule-suppression": "error",
        "react/no-deriving-state-in-effects": "error",
        "react/no-unstable-nested-components": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "error",
        "react/memo-dependencies": "error",
        "react/capitalized-calls": "error",
        "react/set-state-in-effect": "error",
        "react/preserve-manual-memoization": "error",
        "react/refs": "error",
        "react/purity": "error",
        "react/no-array-index-key": "error",
        "react/no-object-type-as-default-prop": "error",
        "react/button-has-type": "error",
        "react/iframe-missing-sandbox": "error",
        "react/jsx-no-script-url": "error",
        "react/no-danger": "error",
        "react/no-clone-element": "error",
        "react/checked-requires-onchange-or-readonly": "error",
        "react/jsx-no-target-blank": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/no-unknown-property": "error",
        "react/self-closing-comp": "error",
        "eslint/no-await-in-loop": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-unnecessary-whitespace": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/no-unknown-classes": ["error", { "ignore": ["^changelog$", "^hljs(?:-.*)?$"] }],
        "better-tailwindcss/enforce-canonical-classes": "error",
        "better-tailwindcss/no-concatenated-classes": "error",
        "better-tailwindcss/enforce-consistent-variable-syntax": "error",
        "better-tailwindcss/enforce-consistent-important-position": "error",
        "better-tailwindcss/enforce-consistent-variant-order": "error",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-ambiguous-text": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/autocomplete-valid": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/interactive-supports-focus": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/lang": "error",
        "jsx-a11y/media-has-caption": "error",
        "jsx-a11y/mouse-events-have-key-events": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/no-autofocus": "error",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
        "jsx-a11y/no-noninteractive-element-interactions": "error",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/no-noninteractive-tabindex": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "nextjs/google-font-display": "error",
        "nextjs/google-font-preconnect": "error",
        "nextjs/inline-script-id": "error",
        "nextjs/next-script-for-ga": "error",
        "nextjs/no-assign-module-variable": "error",
        "nextjs/no-async-client-component": "error",
        "nextjs/no-before-interactive-script-outside-document": "error",
        "nextjs/no-css-tags": "error",
        "nextjs/no-document-import-in-page": "error",
        "nextjs/no-duplicate-head": "error",
        "nextjs/no-head-element": "error",
        "nextjs/no-head-import-in-document": "error",
        "nextjs/no-html-link-for-pages": "error",
        "nextjs/no-img-element": "error",
        "nextjs/no-page-custom-font": "error",
        "nextjs/no-script-component-in-head": "error",
        "nextjs/no-styled-jsx-in-document": "error",
        "nextjs/no-sync-scripts": "error",
        "nextjs/no-title-in-document-head": "error",
        "nextjs/no-typos": "error",
        "nextjs/no-unwanted-polyfillio": "error"
      }
    },
    {
      "files": ["scripts/**/*.{ts,mjs}"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "knip.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      "files": ["packages/db/src/bootstrap-app-role.ts"],
      "rules": {
        "no-console": ["error", { "allow": ["info", "warn", "error"] }]
      }
    },
    {
      "files": ["apps/worker/src/**/*.ts", "apps/deps-worker/src/**/*.ts", "apps/deps-sandbox/src/**/*.ts"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "scripts/tests/**/*.ts"],
      "plugins": ["vitest"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/no-identical-title": "error",
        "vitest/no-duplicate-hooks": "error",
        "vitest/no-commented-out-tests": "error",
        "vitest/prefer-hooks-in-order": "error",
        "vitest/prefer-hooks-on-top": "error",
        "vitest/no-test-return-statement": "error",
        "vitest/no-alias-methods": "error",
        "vitest/no-unneeded-async-expect-function": "error",
        "vitest/prefer-to-be": "error",
        "vitest/prefer-to-have-length": "error",
        "vitest/prefer-mock-return-shorthand": "error",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["apps/web/src/components/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@repopulse/db",
                "message": "UI components must not import @repopulse/db directly; pass serialized data from Server Components or call Server Actions."
              },
              {
                "name": "zod",
                "message": "Keep Zod schemas in server-only src/lib/*-schema.ts modules away from UI components."
              }
            ],
            "patterns": [
              {
                "group": ["**/lib/*-schema", "**/lib/*-schema.*", "@/lib/*-schema"],
                "message": "Keep *-schema modules server-only; do not import them into UI components."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/notifications/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@repopulse/db",
                "message": "@repopulse/notifications must remain decoupled from @repopulse/db."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/deps/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@repopulse/db",
                "message": "@repopulse/deps must remain decoupled from @repopulse/db."
              }
            ],
            "patterns": [
              {
                "group": ["@octokit/*"],
                "message": "@repopulse/deps must not depend on Octokit."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/worker/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@repopulse/deps-worker",
                "message": "apps/worker and apps/deps-worker must never import each other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/deps-worker/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@repopulse/worker",
                "message": "apps/worker and apps/deps-worker must never import each other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/queue/src/events.ts",
        "packages/notifications/src/channels.ts",
        "packages/github/src/watched-paths.ts",
        "packages/deps/src/limits.ts",
        "packages/deps/src/sandbox-contract.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "ioredis",
                "message": "Browser-safe subpaths must not import server dependencies."
              },
              {
                "name": "bullmq",
                "message": "Browser-safe subpaths must not import server dependencies."
              },
              {
                "name": "nodemailer",
                "message": "Browser-safe subpaths must not import server dependencies."
              },
              {
                "name": "@repopulse/db",
                "message": "Browser-safe subpaths must not import @repopulse/db."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Browser-safe subpaths must not import Node.js built-in modules."
              }
            ]
          }
        ]
      }
    }
  ]
}
