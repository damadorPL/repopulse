{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "workspace",
        "elementNamePattern": ["@repopulse/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "workspace",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/app/globals.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "packages/db/src/generated/**",
    "**/next-env.d.ts",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "docs/**"
  ]
}
