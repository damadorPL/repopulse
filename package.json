{
  "name": "repopulse",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "node -e \"if (require('node:fs').existsSync('scripts/install-hooks.ts')) require('node:child_process').execFileSync(process.execPath, ['scripts/install-hooks.ts'], { stdio: 'inherit' })\"",
    "verify": "node scripts/verify.ts",
    "check:guardrails": "node scripts/guardrails.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "lint:manifests": "sherif",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:strict": "knip --strict --dependencies",
    "doctor": "react-doctor --no-telemetry .",
    "doctor:design": "react-doctor design --no-telemetry .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck": "turbo run typecheck && pnpm run typecheck:scripts",
    "test:scripts": "vitest run --project scripts",
    "test": "turbo run test && pnpm run test:scripts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "turbo run db:generate",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "env:setup": "node scripts/setup-env.mjs",
    "env:sync": "node scripts/sync-env.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "deps:check": "node scripts/check-updates.mjs",
    "deps:sandbox:check": "node scripts/check-sandbox-updates.mjs",
    "services:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "1.3.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.2",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "react-doctor": "0.9.23",
    "sherif": "1.13.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
