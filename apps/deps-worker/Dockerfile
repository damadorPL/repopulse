# syntax=docker/dockerfile:1
# Build from the monorepo root:
#   docker build -f apps/deps-worker/Dockerfile -t repopulse-deps-worker .
#
# deps-worker (Slice 08): dependency scans, update pull requests and dependency notifications. It holds secrets
# (database, Redis, GitHub App key, installation tokens) and therefore never runs a package manager: lockfiles are
# regenerated by deps-sandbox over HTTP. Migrations are applied by the `migrator` target of apps/worker/Dockerfile;
# this image has no migrator stage.
FROM node:26-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g pnpm@12.16.1 turbo@2.11.10
WORKDIR /app

# ---- Stage 1: prune the monorepo down to @repopulse/deps-worker and its workspace deps
FROM base AS pruner
COPY . .
RUN npx turbo prune @repopulse/deps-worker --docker

# ---- Stage 2: install deps (cached on lockfile/package.json) and build
FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
# turbo prune keeps the `allowBuilds` block of pnpm-workspace.yaml, so Prisma's install scripts run.
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
# `build` depends on `^db:generate`, so `prisma generate` runs here on Alpine.
RUN pnpm turbo run build --filter=@repopulse/deps-worker

# ---- Stage 3: drop devDependencies (typescript, tsx, vitest, ...) in place.
FROM installer AS prod-deps
RUN CI=true pnpm prune --prod \
 && rm -rf node_modules/.cache .turbo apps/*/.turbo packages/*/.turbo

# ---- Target: production deps-worker runtime (default: last stage)
FROM node:26-alpine AS runner
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
ENV NODE_ENV=production \
    DEPS_HEALTH_PORT=3002
# Copy the whole pruned workspace so pnpm's relative node_modules symlinks
# (node_modules/.pnpm/...) and the generated Prisma client stay valid.
COPY --from=prod-deps /app /app
USER node
EXPOSE 3002
CMD ["node", "apps/deps-worker/dist/index.js"]
