# syntax=docker/dockerfile:1
# Build from the monorepo root:
#   docker build -f apps/deps-worker/Dockerfile -t repopulse-deps-worker .
#
# deps-worker (Slice 08): dependency scans, update pull requests and dependency notifications. It holds secrets
# (database, Redis, GitHub App key, installation tokens) and therefore never runs a package manager: lockfiles are
# regenerated by deps-sandbox over HTTP. Migrations are applied by the `migrator` target of apps/worker/Dockerfile;
# this image has no migrator stage.
FROM node:26-alpine AS base
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g --no-audit --no-fund pnpm@12.23.0 turbo@2.11.13
WORKDIR /app

# ---- Stage 1: prune the monorepo down to @repopulse/deps-worker and its workspace deps
FROM base AS pruner
COPY . .
RUN turbo prune @repopulse/deps-worker --docker

# ---- Stage 2: install deps (cached on lockfile/package.json) and build
FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
# turbo prune keeps the `allowBuilds` block of pnpm-workspace.yaml, so Prisma's install scripts run.
# `--filter @repopulse/deps-worker...` skips root devDependencies (oxlint, vitest, react-doctor, etc.).
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @repopulse/deps-worker...
COPY --from=pruner /app/out/full/ .
# `build` depends on `^db:generate`, so `prisma generate` runs here on Alpine.
# Sharing `id=turbo-alpine` across web/worker/deps-worker reuses compiled @repopulse/* packages.
RUN --mount=type=cache,id=turbo-alpine,target=/app/.turbo/cache \
    turbo run build --filter=@repopulse/deps-worker

# ---- Stage 3: drop devDependencies (typescript, tsx, vitest, ...) and unused TypeScript sources in place.
FROM installer AS prod-deps
RUN CI=true pnpm prune --prod --ignore-scripts --filter @repopulse/deps-worker... \
 && rm -rf node_modules/.cache .turbo apps/*/.turbo packages/*/.turbo apps/*/src packages/*/src \
 && find apps packages -not -path '*/node_modules/*' -name '*.test.ts' -delete

# ---- Target: production deps-worker runtime (default: last stage)
FROM node:26-alpine AS runner
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
ENV NODE_ENV=production \
    DEPS_HEALTH_PORT=3002
# Copy the whole pruned workspace so pnpm's relative node_modules symlinks
# (node_modules/.pnpm/...) and the generated Prisma client stay valid.
COPY --from=prod-deps /app /app
USER node
EXPOSE 3002
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:${DEPS_HEALTH_PORT:-3002}/health >/dev/null || exit 1
CMD ["node", "apps/deps-worker/dist/index.js"]
