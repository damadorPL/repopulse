{
  "name": "@repopulse/worker",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repopulse/db": "workspace:*",
    "@repopulse/github": "workspace:*",
    "@repopulse/notifications": "workspace:*",
    "@repopulse/queue": "workspace:*",
    "bullmq": "6.5.3",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
