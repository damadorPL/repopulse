{
  "name": "@repopulse/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "@repopulse/db": "workspace:*",
    "@repopulse/github": "workspace:*",
    "@repopulse/notifications": "workspace:*",
    "@repopulse/queue": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
