{
  "name": "@repopulse/deps-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "@repopulse/deps": "workspace:*",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@repopulse/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
